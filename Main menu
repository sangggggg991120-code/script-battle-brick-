getgenv().HAMSTER_UPDATE_UI = function(current, total, funcName)
    status.Text = string.format("Quét Anti-Hook: %d/%d (%s)", current, total, funcName)
    task.wait(0.015)
end

local function sendKey(key)
    status.TextColor3 = Color3.fromRGB(200, 200, 210)
    status.Text = "Connecting to server..."

    local requestFunc = syn and syn.request or http and http.request or http_request or request
    if not requestFunc then
        status.TextColor3 = Color3.fromRGB(255, 110, 110)
        status.Text = "✗ Executor does not support HTTP requests!"
        return
    end

    local ok1, res1 = pcall(function()
        return requestFunc({Url = SERVER_URL .. "/api/get-challenge", Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = "{}"})
    end)
    
    if not ok1 or res1.StatusCode ~= 200 then
        status.TextColor3 = Color3.fromRGB(255, 110, 110)
        status.Text = "✗ Server connection failed!"
        return
    end

    local successDecode, data = pcall(function() return HttpService:JSONDecode(res1.Body) end)
    if not successDecode or not data.challenge then
        status.TextColor3 = Color3.fromRGB(255, 110, 110)
        status.Text = "✗ Server returned invalid data!"
        return
    end

    getgenv().HAMSTER_CHALLENGE = data.challenge
    getgenv().HAMSTER_CHALLENGE_ID = data.id
    getgenv().HAMSTER_USER_KEY = key

    TweenService:Create(inputStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(130, 140, 255)}):Play()

    local ANTI_HOOK_URL = "https://sever-7vc0.onrender.com/gethook" 

    local ok2, err2 = pcall(function()
        local antiHookCode = requestFunc({Url = ANTI_HOOK_URL, Method = "GET"}).Body
        local runAntiHook = loadstring(antiHookCode)
        if runAntiHook then
            runAntiHook() 
        else
            error("Invalid Anti-Hook Code")
        end
    end)

    if ok2 then
        status.TextColor3 = Color3.fromRGB(100, 255, 150)
        status.Text = "✓ Key valid! Loading..."
        TweenService:Create(inputStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(100, 255, 150)}):Play()
        task.wait(0.4)
        closeMenu()
    else
        status.TextColor3 = Color3.fromRGB(255, 110, 110)
        status.Text = "✗ Anti-Hook failed or Hook detected!"
        
        TweenService:Create(inputStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(255, 90, 90)}):Play()
        local originalPos = inputHolder.Position
        for i = 1, 4 do
            TweenService:Create(inputHolder, TweenInfo.new(0.05), {Position = originalPos + UDim2.new(0, (i % 2 == 0 and 6 or -6), 0, 0)}):Play()
            task.wait(0.05)
        end
        TweenService:Create(inputHolder, TweenInfo.new(0.05), {Position = originalPos}):Play()
    end
end

